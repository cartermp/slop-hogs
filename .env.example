# Local-only configuration. Never put credentials in a NEXT_PUBLIC_ variable.
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=http://127.0.0.1:3000
# OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OAUTH_ENCRYPTION_KEY=base64-encoded-32-byte-key
# GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# SLOP_HOGS_OWNER_DIDS=did:plc:example
# Production on Railway uses one trusted forwarding proxy.
# TRUSTED_PROXY_COUNT=1
